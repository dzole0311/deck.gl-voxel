{
  "name": "@deck.gl-voxel/example-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    },
    "./styles.css": "./src/styles.css",
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    }
  },
  "dependencies": {
    "@math.gl/core": "4.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "deck.gl-voxel": "workspace:*",
    "deck.gl-voxel-zarr": "workspace:*",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  }
}
