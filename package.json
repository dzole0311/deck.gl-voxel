{
  "name": "deck.gl-voxel-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental deck.gl layer for visualizing volumetric data with WebGPU",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev:maplibre": "pnpm build && pnpm --filter voxel-maplibre-example dev",
    "test": "pnpm build && node --test packages/*/tests/*.test.mjs examples/ui/tests/*.test.mjs",
    "test:browser": "pnpm build && node tests/browser.mjs",
    "build": "tsc --build",
    "watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "dev:aem": "pnpm build && pnpm --filter voxel-aem-example dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@deck.gl/core": "9.4.2",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/webgpu": "9.4.2",
    "deck.gl-voxel": "workspace:*",
    "lefthook": "2.2.2",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
